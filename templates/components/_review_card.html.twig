<div class="bg-luxe-card border border-luxe-border rounded-xl p-5">
    <div class="flex text-luxe-gold mb-2" aria-label="{{ review.rating }} sur 5">
        {% for i in 1..5 %}
            {{ i <= review.rating ? '★' : '☆' }}
        {% endfor %}
    </div>
    <p class="text-sm text-luxe-text mb-3 leading-relaxed">{{ review.comment }}</p>
    <div class="text-xs text-luxe-muted">— {{ review.customerName }}</div>
</div>
